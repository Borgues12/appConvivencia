rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{userUid} {
      allow read, write: if request.auth != null && request.auth.uid == userUid;
    }

    match /salas/{salaId} {

      // Lectura: solo miembros actuales
      allow read: if request.auth != null
        && request.auth.uid in resource.data.salaMiembros;

      // Creación: quien crea debe ponerse a sí mismo como admin y único miembro inicial
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.salaAdminUid
        && request.resource.data.salaMiembros == [request.auth.uid];

      // Unirse: solo se permite agregar el propio uid al array, nada más puede cambiar
      allow update: if request.auth != null
        && request.auth.uid in request.resource.data.salaMiembros
        && request.resource.data.salaMiembros ==
             resource.data.salaMiembros.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salaMiembros']);

      // Configurar horario: solo el admin, y solo puede cambiar salaHoraInicio
      allow update: if request.auth != null
        && request.auth.uid == resource.data.salaAdminUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salaHoraInicio'])
        && request.resource.data.salaHoraInicio.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');

      // Salir (no-admin): quita el propio uid, el admin no cambia
      allow update: if request.auth != null
        && request.auth.uid != resource.data.salaAdminUid
        && !(request.auth.uid in request.resource.data.salaMiembros)
        && request.resource.data.salaMiembros ==
             resource.data.salaMiembros.removeAll([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salaMiembros']);

      // Salir (admin): quita el propio uid y transfiere salaAdminUid a alguien
      // que siga en la sala; bloqueado si el admin es el único miembro
      allow update: if request.auth != null
        && request.auth.uid == resource.data.salaAdminUid
        && resource.data.salaMiembros.size() > 1
        && !(request.auth.uid in request.resource.data.salaMiembros)
        && request.resource.data.salaMiembros ==
             resource.data.salaMiembros.removeAll([request.auth.uid])
        && request.resource.data.salaAdminUid != request.auth.uid
        && request.resource.data.salaAdminUid in request.resource.data.salaMiembros
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salaMiembros', 'salaAdminUid']);
    }
    match /sesiones/{sesionId} {
      // Lectura
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/salas/$(resource.data.sesionSalaId)).data.salaMiembros;

      // Iniciar sesión (pendiente -> en_curso)
      allow update: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/salas/$(resource.data.sesionSalaId)).data.salaMiembros
        && resource.data.sesionEstado == 'pendiente'
        && request.resource.data.sesionEstado == 'en_curso'
        && request.resource.data.sesionIniciadaPorUid == request.auth.uid
        && request.resource.data.sesionPin is string
        && request.resource.data.sesionPin.matches('^[0-9]{4}$')
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sesionEstado', 'sesionPin', 'sesionIniciadaPorUid'])
        && request.resource.data.sesionSalaId == resource.data.sesionSalaId
        && request.resource.data.sesionFecha == resource.data.sesionFecha;

      // Cancelar (admin)
      allow update: if request.auth != null
        && request.auth.uid == get(/databases/$(database)/documents/salas/$(resource.data.sesionSalaId)).data.salaAdminUid
        && (resource.data.sesionEstado == 'pendiente' || resource.data.sesionEstado == 'en_curso')
        && request.resource.data.sesionEstado == 'cancelada'
        && request.resource.data.sesionCanceladaPorUid == request.auth.uid
        && request.resource.data.sesionCanceladaMotivo is string
        && request.resource.data.sesionCanceladaMotivo.size() > 0
        && request.resource.data.sesionSalaId == resource.data.sesionSalaId
        && request.resource.data.sesionFecha == resource.data.sesionFecha
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sesionEstado', 'sesionCanceladaPorUid', 'sesionCanceladaMotivo']);

      // SUBCOLECCIÓN: /sesiones/{sesionId}/checkins/{checkinUid}
      match /checkins/{checkinUid} {
        // Lectura: cualquier miembro de la sala
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/salas/$(get(/databases/$(database)/documents/sesiones/$(sesionId)).data.sesionSalaId)).data.salaMiembros;

        // Creación: cada miembro registra su propio check-in
        allow create: if request.auth != null
        && request.auth.uid == checkinUid
        && request.resource.data.keys().hasOnly(
            ['checkinUserUid', 'checkinEstado', 'checkinMotivo', 'checkinHora'])
        && request.resource.data.checkinUserUid == checkinUid
        && request.resource.data.checkinEstado in ['a_tiempo', 'retraso']
        && (request.resource.data.checkinEstado == 'a_tiempo'
            || (request.resource.data.checkinMotivo is string
                && request.resource.data.checkinMotivo.trim().size() >= 10))
        && getAfter(/databases/$(database)/documents/sesiones/$(sesionId)).data.sesionEstado == 'en_curso'
        && request.auth.uid in get(/databases/$(database)/documents/salas/$(get(/databases/$(database)/documents/sesiones/$(sesionId)).data.sesionSalaId)).data.salaMiembros;
      }
    }
    match /faltas/{faltaId} {
      // Lectura solo los miembros de la sala
      allow read: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/salas/$(resource.data.faltaSalaId)).data.salaMiembros;
      allow write: if false;
    }
}
}

